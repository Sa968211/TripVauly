{
  "name": "tripvault-root",
  "version": "1.0.0",
  "private": true,
  "description": "TripVault MERN Application - Root workspace",
  "scripts": {
    "open": "powershell -Command \"Start-Process 'http://localhost:3000/dashboard'\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0"
  }
}
